{
  // once published, this ships inside the npm package itself
  "$schema": "./node_modules/mutate-js/mutate.config.schema.json",

  // glob patterns for files to mutate
  "mutate": ["src/**/*.js"],
  "ignorePatterns": ["src/**/*.test.js"],

  "testRunner": "jest",
  "testFilter": "related",
  "cache": ".mutate-cache.json",

  // run the suite unmutated first and abort if it fails
  "dryRun": true,
  // mutants tested concurrently within a file; each Jest/Vitest run already
  // uses its own worker pool, so raise this deliberately
  "concurrency": 1,

  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50,
  },
}
