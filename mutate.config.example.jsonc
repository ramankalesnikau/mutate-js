{
  // once published, this ships inside the npm package itself
  "$schema": "./node_modules/mutate-js/mutate.config.schema.json",

  // glob patterns for files to mutate
  "mutate": ["src/**/*.js"],
  "ignorePatterns": ["src/**/*.test.js"],

  "testRunner": "jest",
  "relatedTests": true,
  "cache": ".mutate-cache.json",

  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50,
  },
}
